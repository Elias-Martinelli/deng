# ---------------------------------------------------------------------------
# Champions League Match Intelligence Data Platform – environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Football data (football-data.org, free tier) ---------------------------
# Register at https://www.football-data.org/client/register (free, e-mail only).
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# Competition code for the UEFA Champions League on football-data.org
FOOTBALL_DATA_COMPETITION=CL
# Past seasons to fetch once, as comma-separated start years. Empty = only the
# current season (what a daily run needs). These are the training data for a
# model: one season is one request, e.g. 2023 -> 125 matches, 2024 -> 189.
FOOTBALL_DATA_SEASONS=

# --- Weather data (Open-Meteo) ----------------------------------------------
# No API key needed for non-commercial use. Kept configurable for testing.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Bookmaker odds (The Odds API, free tier: 500 credits/month) -----------
# Optional. Without a key the odds step skips itself and the app says so.
# Register at https://the-odds-api.com (free, e-mail only).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT=soccer_uefa_champs_league
# One region x one market = one credit per fetch. Comma-separated bookmaker keys
# narrow the answer (empty = every bookmaker of the region), not the cost.
ODDS_API_REGIONS=eu
ODDS_API_BOOKMAKERS=
# Budget rules, applied by the pipeline (never by the app):
#   once a day always; every ODDS_REFRESH_MINUTES while a watched match is within
#   ODDS_WATCH_HOURS_BEFORE_KICKOFF; never below ODDS_QUOTA_RESERVE credits.
# 15 min x 48 h = 192 credits per watched matchday - budget accordingly.
ODDS_REFRESH_MINUTES=15
ODDS_WATCH_HOURS_BEFORE_KICKOFF=48
# Comma-separated match ids to watch (empty = every unfinished match in the window)
ODDS_WATCH_MATCH_IDS=
ODDS_QUOTA_RESERVE=50

# --- Local PostgreSQL (Docker Compose) --------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cl_intelligence
POSTGRES_USER=deng
POSTGRES_PASSWORD=change-me

# --- Streamlit viewer ---------------------------------------------------------
STREAMLIT_PORT=8501

# --- Dagster (orchestrator UI) ----------------------------------------------
DAGSTER_PORT=3000

# --- Pipeline behaviour -------------------------------------------------------
# Source of the scheduled ingestion in Dagster: api | samples. `samples` replays
# the committed payloads, so schedules and backfills work without an API key.
INGEST_SOURCE=api
# Where raw API payloads are written locally (dev/cache only, git-ignored)
LOCAL_RAW_DIR=data/raw
LOG_LEVEL=INFO

# --- Google Cloud (final milestone) -----------------------------------------
GCP_PROJECT_ID=
GCP_REGION=europe-west6
GCS_RAW_BUCKET=
BIGQUERY_DATASET=cl_intelligence
# Path to a service-account key for local testing only. Prefer
# `gcloud auth application-default login`; never commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=
