# ---------------------------------------------------------------------------
# Champions League Match Intelligence Data Platform – environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Football data (football-data.org, free tier) ---------------------------
# Register at https://www.football-data.org/client/register (free, e-mail only).
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# Competition code for the UEFA Champions League on football-data.org
FOOTBALL_DATA_COMPETITION=CL

# --- Weather data (Open-Meteo) ----------------------------------------------
# No API key needed for non-commercial use. Kept configurable for testing.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Local PostgreSQL (Docker Compose) --------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cl_intelligence
POSTGRES_USER=deng
POSTGRES_PASSWORD=change-me

# --- Pipeline behaviour -------------------------------------------------------
# Where raw API payloads are written locally (dev/cache only, git-ignored)
LOCAL_RAW_DIR=data/raw
LOG_LEVEL=INFO

# --- Google Cloud (final milestone) -----------------------------------------
GCP_PROJECT_ID=
GCP_REGION=europe-west6
GCS_RAW_BUCKET=
BIGQUERY_DATASET=cl_intelligence
# Path to a service-account key for local testing only. Prefer
# `gcloud auth application-default login`; never commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=
